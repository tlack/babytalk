CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3 cam: ESP32-S3R8, 16MB flash, 8MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# ESP-DL allocates its activations with plain malloc when they exceed internal RAM.
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Cache geometry matters for PSRAM/flash bandwidth; mem bench reports it.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Console on the native USB (303a:1001, same VID:PID as ROM download mode,
# so one usbipd bind covers flashing and running).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Inference hogs a core for seconds at a time.
CONFIG_ESP_TASK_WDT_EN=n

CONFIG_FATFS_LFN_HEAP=y

# ESP-DL is C++ and wants exceptions off / larger main stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# WiFi transport (TCP server for PCM in / results out). Keep WiFi/lwIP buffers out
# of internal RAM: the model already leaves only ~147KB there.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# ESP-DL's model metadata is thousands of small mallocs; by default everything <= 16KB
# goes to internal RAM first (loading the model took ~123KB of it). Keep internal RAM for
# stacks, WiFi and the 64KB 1x1-conv filter staging buffer (espdl/patches).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
