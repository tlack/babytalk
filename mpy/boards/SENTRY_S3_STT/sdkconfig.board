CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# app 3MB, model 6MB (int4 .mmrt: 5.99MB), then MicroPython's auto "vfs" (~7MB).
# build.sh copies partitions-stt.csv next to the port's own tables.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-sentry-stt.csv"

# Cache geometry the mmrt numbers were measured with (weights stream through the dcache).
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_SPEED_80M=y
