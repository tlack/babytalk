+    /**
+     * micromodels: int8 1x1 convs stream their whole filter once per output pixel, so with
+     * weights left in flash (param_copy=false) the kernel waits on the cache/flash instead of
+     * computing. Copy the filter into a fixed internal-SRAM buffer once per call and point the
+     * args at it: same kernel, same arithmetic (bit-exact), weights now at SRAM speed.
+     */
+    template <typename T, typename filter_t>
+    void stage_filter_in_sram(TensorBase *filter, base::ConvOpArgs<T, filter_t> &args)
+    {
+        if (sizeof(T) != 1 || sizeof(filter_t) != 1 || m_group != 1) return;
+        auto &a0 = args.get_args(0);
+        if (a0.filter_height != 1 || a0.filter_width != 1) return;
+        size_t cap = 0;
+        uint8_t *buf = (uint8_t *)dl_conv_sram_filter_buf(&cap);
+        const uint8_t *src = (const uint8_t *)filter->get_element_ptr();
+        size_t bytes = filter->get_bytes();
+        if (!buf || bytes > cap || esp_ptr_internal(src)) return;
+        memcpy(buf, src, bytes);
+        intptr_t delta = buf - src;
+        for (size_t i = 0; i < args.size(); i++) {
+            auto &a = args.get_args(i);
+            a.filter_element = (const uint8_t *)a.filter_element + delta;
+            if (a.filter_element_unaligned) a.filter_element_unaligned = (const uint8_t *)a.filter_element_unaligned + delta;
+        }
+    }
