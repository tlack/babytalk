# Overlay on AtomVM's ESP32 defaults (atomvm/build.sh passes it after sdkconfig.defaults).
# Waveshare ESP32-S3-CAM: ESP32-S3R8, 16 MB QIO flash, 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-babytalk.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM: malloc() above 4 KB goes there (Erlang heaps, big binaries); small blocks stay internal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Cache geometry the MMRT kernels were measured with
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Internal RAM is scarce: no Bluetooth
CONFIG_BT_ENABLED=n

# Our C code owns I2C with the new i2c_master driver; AtomVM's I2C uses the legacy driver,
# and ESP-IDF aborts at boot when both are linked.
CONFIG_AVM_ENABLE_I2C_PORT_DRIVER=n
CONFIG_AVM_ENABLE_I2C_RESOURCE_NIFS=n

# Console on the chip's USB-Serial-JTAG (same USB identity as download mode)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Belt and braces: if anything still links the legacy I2C driver, don't abort at boot
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
