# ESP32-S3 with quad (QSPI) PSRAM: atomvm/build.sh esp32s3_quad, e.g. the LilyGO T-LoRa Pager
# (ESP32-S3, 16 MB flash, 8 MB quad PSRAM). Loaded after sdkconfig.babytalk and
# sdkconfig.babytalk.esp32s3, so it overrides their octal PSRAM. Quad PSRAM has about half the
# bandwidth of octal: transcription is slower (MMRT reads activations and cached weights there).
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_SPEED_80M=y
