diff -ruN '--exclude=*.a' '--exclude=CHECKSUMS.json' a/dl/module/src/dl_module_conv_sram.cpp b/dl/module/src/dl_module_conv_sram.cpp
--- a/dl/module/src/dl_module_conv_sram.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/dl/module/src/dl_module_conv_sram.cpp	2026-09-23 23:13:20.329348316 -0400
@@ -0,0 +1,23 @@
+// micromodels: internal-SRAM staging buffer for int8 1x1 conv filters (see
+// Conv::stage_filter_in_sram). Static .bss so it is reserved before WiFi and the model
+// fragment the heap. 64KB = a 256x256 int8 filter, the shape of nearly every 1x1 conv in
+// Citrinet-256; bigger filters fall back to reading in place.
+#include <stddef.h>
+#include <stdint.h>
+
+#include "esp_attr.h"
+
+#define DL_CONV_SRAM_FILTER_BYTES (64 * 1024)
+
+static DRAM_ATTR uint8_t s_buf[DL_CONV_SRAM_FILTER_BYTES] __attribute__((aligned(16)));
+
+static bool s_enabled = true;
+
+// Runtime switch (for A/B checks against stock behaviour): false = read filters in place.
+extern "C" void dl_conv_sram_enable(bool on) { s_enabled = on; }
+
+extern "C" void *dl_conv_sram_filter_buf(size_t *cap)
+{
+    *cap = s_enabled ? sizeof(s_buf) : 0;
+    return s_enabled ? s_buf : NULL;
+}
